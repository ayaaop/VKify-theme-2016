{extends "../@layout.latte"}

{if !$user->isBanned()}
    {var $backdrops = $user->getBackDropPictureURLs()}
{/if}

{block title}{$user->getCanonicalName()}{/block} 

{block headIncludes}
    {if $user->getPrivacyPermission('page.read', $thisUser ?? NULL)}
    <!-- openGraph -->
    <meta property="og:title" content="{$user->getCanonicalName()}" />
    <meta property="og:url" content="http://{$_SERVER['HTTP_HOST']}{$user->getURL()}" />
    <meta property="og:image" content="{$user->getAvatarUrl('normal')}" />
    <meta property="og:type" content="profile" />
    <meta property="og:first_name" content="{$user->getFirstName()}" />
    <meta property="og:last_name" content="{$user->getLastName()}" />
    <meta n:if="!is_null($user->getShortcode())" property="og:username" content="{$user->getShortcode()}" />
    <meta property="og:gender" content="{($user->isFemale() ? 'fe' : '')}male" />
    
    <!-- json-ld -->
    <script type="application/ld+json">
        {
            "@context": "http://schema.org/",
            "type": "Person",
            "name": {$user->getCanonicalName()},
            "url": {('http://') . $_SERVER['HTTP_HOST'] . $user->getURL()}
        }
    </script>
    {else} 
    <meta name="robots" content="noindex, noarchive">
    {/if}
{/block}

{var $transparentAppbar = true}

{block appbar_extra}
<div class="mobileonly" id="profile_appbar_extra">
    <button class="appbar-extra-btn" id="profileAppbarMoreBtn" aria-label="More actions"
        data-tippy-content-id="mobile_appbar_menu_content"
        data-tippy-placement="bottom-end"
        data-tippy-preset="appbar_menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
    </button>
</div>
{/block}

{block content}
    {var $videos = iterator_to_array($videos)}
    {var $audios = iterator_to_array($audios)}
    {var $albums = iterator_to_array($albums)}
    {if !$user->isBanned()}
    
    {if !$user->getPrivacyPermission('page.read', $thisUser ?? NULL)}
        <div class="msg msg_err">
            <b>{_forbidden}</b><br/>
            {_forbidden_comment}
        </div>
    {else}
    
    <div class="mobile-profile-hero mobileonly">
        <div class="mobile-hero-img-wrap">
            <img src="{$user->getAvatarUrl('large')}" alt="{$user->getCanonicalName()}" class="mobile-hero-img" />
            <div class="mobile-hero-gradient"></div>
            <div class="mobile-hero-info">
                <h2 class="mobile-hero-name">{$user->getFullName()} <a class="page_verified" n:if="$user->isVerified()" href="/verify"></a></h2>
                <div class="mobile-hero-status">
                    {if $user->onlineStatus() == 2}
                        {_deceased_person}
                    {elseif $user->isOnline()}
                        {_online}
                    {elseif $user->getOnline()->timestamp() + 2505600 > time()}
                        {$user->isFemale() ? tr("was_online_f") : tr("was_online_m")} {$user->getOnline()}
                    {/if}
                </div>
            </div>
        </div>
    </div>

	{* Mobile-only: action buttons + info rows + scroll strip *}
	<div class="mobileonly mobile-profile-content">

		<div class="page_block mobile-actions-info-block">
			{* Action buttons — inline mobile layout (mirrors profile_actions.latte mobile block) *}
			<div class="mobile-actions-wrap">
				<div class="mobile_profile_actions">
					{ifset $thisUser}
						{if $user->getId() == $thisUser->getId()}
							<a class="button button_blue button_wide mobile_profile_action_btn" href="/edit">{_edit_page}</a>
						{elseif !$user->isBanned() && !$user->isDeleted() && !$user->isDeactivated()}
							{if !$user->isBlacklistedBy($thisUser) && !$thisUser->isBlacklistedBy($user)}
								<div class="mobile_profile_action_primary">
									{if \OPENVK_ROOT_CONF['openvk']['preferences']['commerce']}
										{if $user->getPrivacyPermission('messages.write', $thisUser)}
											<a class="button button_blue mobile_profile_action_btn" href="/im?sel={$user->getId()}">{_send_message}</a>
										{else}
											<a class="button button_blue mobile_profile_action_btn" href="/gifts?act=pick&user={$user->getId()}">{_gift}</a>
										{/if}
									{else}
										{if $user->getPrivacyPermission('messages.write', $thisUser)}
											<a class="button button_blue mobile_profile_action_btn" href="/im?sel={$user->getId()}">{_send_message}</a>
										{/if}
									{/if}
								</div>
								{var $subStatus3 = $user->getSubscriptionStatus($thisUser)}
								{var $actions3 = [
									0 => ['act' => 'add', 'label' => tr('friends_add')],
									1 => ['act' => 'add', 'label' => tr('friends_accept'), 'class' => 'button_gray'],
									2 => ['act' => 'rem', 'label' => tr('friends_reject'), 'class' => 'button_gray'],
									3 => ['act' => 'rem', 'label' => tr('friends_delete'), 'class' => 'button_gray']
								]}
								{if isset($actions3[$subStatus3])}
									<div class="mobile_profile_action_secondary">
										<form action="/setSub/user" method="post">
											<input type="hidden" name="act" value="{$actions3[$subStatus3]['act']}" />
											<input type="hidden" name="id" value="{$user->getId()}" />
											<input type="hidden" name="hash" value="{$csrfToken}" />
											<input type="submit" value="{$actions3[$subStatus3]['label']}" class="button mobile_profile_action_btn {if isset($actions3[$subStatus3]['class'])}{$actions3[$subStatus3]['class']}{else}button_gray{/if}" />
										</form>
									</div>
								{/if}
							{/if}
						{/if}
					{else}
						<div class="guest_actions">
							<vkifyloc name="guest_actions" args="{$user->getFirstName()}" />
						</div>
					{/ifset}
				</div>
			</div>

					{* Info rows *}
					<div class="mobile-info-rows">
						{var $thatIsThisUser2 = isset($thisUser) && $user->getId() == $thisUser->getId()}
						{if $audioStatus}
							<div class="mobile-info-row">
								<div class="mir-icon mir-icon-status"></div>
								<div class="mir-text">
									<a {if !$thatIsThisUser2}href="/audio0_{$audioStatus->getId()}"{/if}>{$audioStatus->getName()}</a>
								</div>
							</div>
						{elseif $user->getStatus()}
							<div class="mobile-info-row {if $thatIsThisUser2}mobile-info-row-editable{/if}" {if $thatIsThisUser2}onclick="__mobileEditStatus()"{/if}>
								<div class="mir-icon mir-icon-status"></div>
								<div class="mir-text" id="mobile_status_display">{$user->getStatus()}</div>
							</div>
						{elseif $thatIsThisUser2}
							<div class="mobile-info-row mobile-info-row-editable" onclick="__mobileEditStatus()">
								<div class="mir-icon mir-icon-status"></div>
								<div class="mir-text mir-text-muted" id="mobile_status_display">{_change_status}</div>
							</div>
						{/if}
						{if $user->getPrivacyPermission('friends.read', $thisUser ?? NULL) && $user->getFriendsCount() > 0}
							<div class="mobile-info-row">
								<div class="mir-icon mir-icon-friends"></div>
								<div class="mir-text">
									<a href="/friends{$user->getId()}">{tr("friends", $user->getFriendsCount())}</a>
									{if $user->getFriendsOnlineCount() > 0}
										<span class="mir-muted"> &bull; {$user->getFriendsOnlineCount()} {tr("online_short")}</span>
									{/if}
								</div>
							</div>
						{/if}
						{if $user->getFollowersCount() > 0 && $user->getPrivacyPermission('friends.read', $thisUser ?? NULL)}
							<div class="mobile-info-row">
								<div class="mir-icon mir-icon-followers"></div>
								<div class="mir-text">
									<a href="/friends{$user->getId()}?act=incoming">{tr("followers", $user->getFollowersCount())}</a>
								</div>
							</div>
						{/if}
						{if !is_null($user->getHometown())}
							<div class="mobile-info-row">
								<div class="mir-icon mir-icon-home"></div>
								<div class="mir-text"><a href="/search?section=users&q=&hometown={urlencode($user->getHometown())}">{$user->getHometown()}</a></div>
							</div>
						{/if}
						<div class="mobile-info-row mobile-info-row-more" onclick="__mobileProfileShowMore()">
							<div class="mir-icon mir-icon-more"></div>
							<div class="mir-text mir-text-link">{_additional_information}</div>
						</div>
					</div>
					</div>{* /page_block mobile-actions-info-block *}

					{* Horizontally-scrolling modules strip *}
					<div class="page_block mobile-scroll-modules">
						{if $videosCount > 0 && $user->getPrivacyPermission('videos.read', $thisUser ?? NULL)}
							{var $firstVideo = $videos[0] ?? null}
							<a class="msm-card msm-card-video" href="/videos{$user->getId()}">
								<div class="msm-header">{_videos} <span class="msm-count">{$videosCount}</span></div>
								<div class="msm-body">
									{if $firstVideo}
										<div class="msm-video-thumb" style="background-image: url('{$firstVideo->getThumbnailURL()}');"></div>
										<div class="msm-video-play-icon"></div>
									{else}
										<div class="msm-placeholder-icon msm-icon-video"></div>
									{/if}
								</div>
							</a>
						{/if}
						{if $audiosCount > 0 && $user->getPrivacyPermission('audios.read', $thisUser ?? NULL)}
							{var $firstAudio = $audios[0] ?? null}
							<a class="msm-card msm-card-audio" href="/audios{$user->getId()}">
								<div class="msm-header">{_audios} <span class="msm-count">{$audiosCount}</span></div>
								<div class="msm-body">
									<div class="msm-audio-note">
										<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
									</div>
									{if $firstAudio}
										<div class="msm-audio-title">{$firstAudio->getTitle()|truncate:40}<br>{$firstAudio->getPerformer()|truncate:40}</div>
									{/if}
								</div>
							</a>
						{/if}
						{if $user->getClubCount() > 0 && $user->getPrivacyPermission('groups.read', $thisUser ?? NULL)}
							<a class="msm-card msm-card-groups" href="/groups{$user->getId()}">
								<div class="msm-header">{_groups} <span class="msm-count">{$user->getClubCount()}</span></div>
								<div class="msm-body msm-groups-grid">
									{foreach array_slice(iterator_to_array($user->getClubs(1)), 0, 9) as $club}
										<div class="msm-group-cell">
											{include '../components/avatar.latte', author => $club, size => 'miniscule', width => 50, height => 50, alt => $club->getCanonicalName(), class => 'msm-group-img'}
										</div>
									{/foreach}
								</div>
							</a>
						{/if}
						{if $albumsCount > 0 && $user->getPrivacyPermission('photos.read', $thisUser ?? NULL)}
							{var $firstAlbum = $albums[0] ?? null}
							<a class="msm-card msm-card-albums" href="/albums{$user->getId()}">
								<div class="msm-header">{_albums} <span class="msm-count">{$albumsCount}</span></div>
								<div class="msm-body">
									{if $firstAlbum && $firstAlbum->getCoverPhoto()}
										<img src="{$firstAlbum->getCoverPhoto()->getURLBySizeId('normal')}" class="msm-album-cover" alt="" />
									{else}
										<div class="msm-placeholder-icon msm-icon-album"></div>
									{/if}
								</div>
							</a>
						{/if}
						{if \OPENVK_ROOT_CONF['openvk']['preferences']['commerce'] && $user->getGiftCount() > 0}
							<a class="msm-card msm-card-gifts" href="/gifts{$user->getId()}">
								<div class="msm-header">{_gifts} <span class="msm-count">{$user->getGiftCount()}</span></div>
								<div class="msm-body msm-gifts-grid">
									{foreach $user->getGifts(1, 9) as $giftDesc}
										<div class="msm-gift-cell">
											<img class="msm-gift-img" src="{$giftDesc->gift->getImage(2)}" alt="" />
										</div>
									{/foreach}
								</div>
							</a>
						{/if}
					</div>

	</div>{* /mobile-profile-content *}

    <div class="wide_column_right">
        <div class="narrow_column_wrap">
            <div class="narrow_column">
				<div class="page_block photo_block nomobile">
					{var $hasAvatar = !str_contains($user->getAvatarUrl('miniscule'), "/assets/packages/static/openvk/img/camera_200.png")}
					<div class="avatar_block">
						<div class="avatar_block_inner">
							{if $thisUser && $user->getId() == $thisUser->getId()}
								<a {if $hasAvatar}style="display:none"{/if} class="add_image_text" id="vkify_add_image">{_add_image}</a>
								<div {if !$hasAvatar}style="display:none"{/if} class="avatar_controls">
									<div class="avatarDelete hoverable"></div>
									<div class="avatar_variants">
										<a class="_add_image hoverable" id="vkify_add_image"><span>{_upload_new_picture}</span></a>
									</div>
								</div>
							{/if}
							{var $avatarPhoto = $user->getAvatarPhoto()}
							{var $avatarSizes = $avatarPhoto ? $avatarPhoto->getSizes() : null}
							{var $avatarNormal = $avatarSizes['normal'] ?? null}
							<a href="{$user->getAvatarLink()|nocheck}" style="display: block; line-height: 0;">
								{include '../components/avatar.latte', author => $user, size => 'normal', id => 'bigAvatar', width => ($avatarNormal ? $avatarNormal->width : 200), height => ($avatarNormal ? $avatarNormal->height : 200), alt => $user->getCanonicalName(), style => 'width: 100%; image-rendering: -webkit-optimize-contrast;', onclick => ($avatarPhoto ? "event.preventDefault(); OpenMiniature(event, '{$user->getAvatarUrl('normal')}', null, '{$avatarPhoto->getPrettyId()}', null);" : null), class => ''}
							</a>
						</div>
					</div>
					{include '../components/profile_actions.latte'}
				</div>

				<div n:if="isset($thisUser) && !$thisUser->prefersNotToSeeRating()" n:ifcontent class="page_block module completeness_block nomobile">
					{var $completeness = $user->getProfileCompletenessReport()}
					
					{if isset($thisUser) && $user->getId() === $thisUser->getId() && sizeof($completeness->unfilled) > 0}
						<div class="profile_warning_row" data-warning="interests" style="display: none;" n:if="in_array('interests', $completeness->unfilled)">
							<div class="profile_warning_hide_wrap" onclick="Profile.hideWarning('interests', event)"><div class="profile_warning_hide"></div></div>
							<div class="profile_warning_img interests"></div>
							<div class="profile_warning_label">
								<a href="/edit?act=interests">{_interests} <span class="unfilled_rating">+20%</span></a>
							</div>
						</div>
						
						<div class="profile_warning_row" data-warning="email" style="display: none;" n:if="in_array('email', $completeness->unfilled)">
							<div class="profile_warning_hide_wrap" onclick="Profile.hideWarning('email', event)"><div class="profile_warning_hide"></div></div>
							<div class="profile_warning_img email"></div>
							<div class="profile_warning_label">
								<a href="/edit?act=contacts">Email <span class="unfilled_rating">+20%</span></a>
							</div>
						</div>
						
						<div class="profile_warning_row" data-warning="phone" style="display: none;" n:if="in_array('phone', $completeness->unfilled)">
							<div class="profile_warning_hide_wrap" onclick="Profile.hideWarning('phone', event)"><div class="profile_warning_hide"></div></div>
							<div class="profile_warning_img phone"></div>
							<div class="profile_warning_label">
								<a href="/edit?act=contacts">{_phone} <span class="unfilled_rating">+20%</span></a>
							</div>
						</div>
						
						<div class="profile_warning_row" data-warning="telegram" style="display: none;" n:if="in_array('telegram', $completeness->unfilled)">
							<div class="profile_warning_hide_wrap" onclick="Profile.hideWarning('telegram', event)"><div class="profile_warning_hide"></div></div>
							<div class="profile_warning_img telegram"></div>
							<div class="profile_warning_label">
								<a href="/edit?act=contacts">Telegram <span class="unfilled_rating">+15%</span></a>
							</div>
						</div>
						
						<div class="profile_warning_row" data-warning="status" style="display: none;" n:if="in_array('status', $completeness->unfilled)">
							<div class="profile_warning_hide_wrap" onclick="Profile.hideWarning('status', event)"><div class="profile_warning_hide"></div></div>
							<div class="profile_warning_img status"></div>
							<div class="profile_warning_label">
								<a href="/edit">{_status} <span class="unfilled_rating">+15%</span></a>
							</div>
						</div>
					{/if}
				</div>
				<div class="leftDataBlock">
					<div class="page_block nomobile" n:if="$user->getFriendsCount() > 0 && $user->getPrivacyPermission('friends.read', $thisUser ?? NULL)">
						<div class="module clear people_module" n:if="$user->getFriendsCount() > 0 && $user->getPrivacyPermission('friends.read', $thisUser ?? NULL)">
							<a href="/friends{$user->getId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_friends}
									</span>
									<span class="header_count fl_l">
										{$user->getFriendsCount()}
									</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<div class="search_row" n:foreach="array_chunk(array_slice(iterator_to_array($user->getFriends(1)), 0, 6), 3) as $friendRow">
									<div class="people_cell" n:foreach="$friendRow as $friend">
										<a class="people_cell_ava" href="{$friend->getURL()}">
											{include '../components/avatar.latte', author => $friend, size => 'miniscule', width => 50, height => 50, alt => $friend->getFirstName(), class => 'people_cell_img'}
										</a>
										<div class="people_cell_name"><a href="{$friend->getURL()}">{$friend->getFirstName()}</a></div>
									</div>
								</div>
							</div>
						</div>
						<div class="module clear people_module" n:if="$user->getFriendsOnlineCount() > 0 && $thisUser != NULL && $thisUser->getId() == $user->getId()">
							<a href="/friends{$user->getId()}?act=online" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_friends_online}
									</span>
									<span class="header_count fl_l">
										{$user->getFriendsOnlineCount()}
									</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<div class="search_row" n:foreach="array_chunk(array_slice(iterator_to_array($user->getFriendsOnline(1)), 0, 6), 3) as $friendRow">
									<div class="people_cell" n:foreach="$friendRow as $friend">
										<a class="people_cell_ava" href="{$friend->getURL()}">
												{include '../components/avatar.latte', author => $friend, size => 'miniscule', width => 50, height => 50, alt => $friend->getFirstName(), class => 'people_cell_img'}
										</a>
										<div class="people_cell_name"><a href="{$friend->getURL()}">{$friend->getFirstName()}</a></div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="page_block nomobile" id="gifts_block" n:if="\OPENVK_ROOT_CONF['openvk']['preferences']['commerce'] && ($giftCount = $user->getGiftCount()) > 0">
						<div class="module clear profile_gifts">
							<a class="module_header" href="/gifts{$user->getId()}">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">{_gifts}</span>
									<span class="header_count fl_l" id="gifts_module_count">{$giftCount}</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<a class="profile_gifts_cont" href="/gifts{$user->getId()}">
									<img width="64" height="64" class="profile_gift_img" n:foreach="$user->getGifts(1, 3) as $giftDescriptor" 
										src="{$giftDescriptor->gift->getImage(2)}" 
										title="{$giftDescriptor->anon ? tr('gift') : tr('sender') . ': ' . $giftDescriptor->sender->getFirstName()}{$giftDescriptor->caption ? ($giftDescriptor->anon ? ' - ' : "\n") . $giftDescriptor->caption : ''}" />
								</a>
							</div>
						</div>
					</div>
					<div class="page_block nomobile" n:if="($albumsCount > 0 && $user->getPrivacyPermission('photos.read', $thisUser ?? NULL)) || ($videosCount > 0 && $user->getPrivacyPermission('videos.read', $thisUser ?? NULL))">
						<div class="module clear page_list_module" n:if="$user->getClubCount() > 0 && $user->getPrivacyPermission('groups.read', $thisUser ?? NULL)">
							<a href="/groups{$user->getId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_groups}
									</span>
									<span class="header_count fl_l">
										{$user->getClubCount()}
									</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<div class="line_cell clear_fix" n:foreach="array_slice(iterator_to_array($user->getClubs(1)), 0, 5) as $club">
									<div class="thumb">
										<a href="club{$club->getId()}">
											{include '../components/avatar.latte', author => $club, size => 'miniscule', width => 40, height => 40, alt => $club->getCanonicalName(), class => 'cell_img'}
										</a>
									</div>
									<div class="desc_info">
										<div class="group_name"><a href="club{$club->getId()}">{$club->getName()|truncate:50}</a></div>
										<div class="group_desc">
											<span>{$club->getDescription()|truncate:50}</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="module clear page_list_module" n:if="$user->getMeetingCount() > 0 && $user->getPrivacyPermission('groups.read', $thisUser ?? NULL)">
							<a href="/groups{$user->getId()}?act=meetings" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_meetings}
									</span>
									<span class="header_count fl_l">
										{$user->getMeetingCount()}
									</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<div class="line_cell clear_fix" n:foreach="array_slice(iterator_to_array($user->getMeetings(1)), 0, 5) as $meeting">
									<div class="thumb">
										<a href="/event{$meeting->getId()}">
											{include '../components/avatar.latte', author => $meeting, size => 'miniscule', width => 40, height => 40, alt => $meeting->getName(), class => 'cell_img'}
										</a>
									</div>
									<div class="desc_info">
										<div class="group_name"><a href="/event{$meeting->getId()}">{$meeting->getName()|truncate:50}</a></div>
										<div class="group_desc">
												<span>{$meeting->getDescription()|truncate:50}</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="module topics_module notes_module page_list_module" n:if="$notesCount > 0 && $user->getPrivacyPermission('notes.read', $thisUser ?? NULL)">
							<a href="/notes{$user->getId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_notes}
									</span>
									<span class="header_count fl_l">
										{$notesCount}
									</span>
								</h3>
							</a>
							<div class="module_body" style="padding-block: 10px;">
								<div class="topic_row clear_fix" n:foreach="$notes as $note" style="padding-top: 0;">
									<div class="topic_info_wrap">
										<a href="/note{$note->getPrettyId()}">
											<div class="topic_icon"></div>
											<div class="topic_title">
												{$note->getName()|truncate:50}
											</div>
										</a>
										<div class="topic_info">
											{$note->getPublicationTime()}
											<span class="divide"></span>
											<a href="/note{$note->getPrettyId()}">{_comments}</a>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="module album_module" n:if="$albumsCount > 0 && $user->getPrivacyPermission('photos.read', $thisUser ?? NULL)">
							<a href="/albums{$user->getId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_albums}
									</span>
									<span class="header_count fl_l">
										{$albumsCount}
									</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<div class="clear_fix clear page_album_row" n:foreach="array_slice(iterator_to_array($albums), 0, 3) as $album">
									<a href="/album{$album->getPrettyId()}" class="page_album_link {if is_null($album->getCoverPhoto())}page_album_nocover{/if}">
										{var $cover = $album->getCoverPhoto()}
										<div class="page_album_thumb_wrap">
											<img n:if="!is_null($cover)"
												src="{$cover->getURLBySizeId('normal')}"
												class="page_album_thumb" loading="lazy" />
										</div>
										<div class="page_album_title">
											<div class="page_album_size">{$album->getPhotosCount()}</div>
											<div class="page_album_title_text">{$album->getName()|truncate:50}</div>
										</div>
									</a>
								</div>
							</div>
						</div>
						<div class="module video_module" n:if="$videosCount > 0 && $user->getPrivacyPermission('videos.read', $thisUser ?? NULL)">
							<a href="/videos{$user->getId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_videos}
									</span>
									<span class="header_count fl_l">
										{$videosCount}
									</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<div class="video_row" n:foreach="$videos as $video">
									<a id="videoOpen" data-id="{$video->getPrettyId()}" class="video fl_l" href="/video{$video->getPrettyId()}">
										<div class="video_thumb_label">
											{if $video->getType() != 0}
												<span class="video_thumb_label_item">
													{$video->getType() == \openvk\Web\Models\Entities\Video::TYPE_EMBED ? 'YouTube' : ''}
												</span>
												{if $video->getFormattedLength() != '00:00'}
													<div class="divider"></div>
													{$video->getFormattedLength()}
												{/if}
											{else}
												{$video->getFormattedLength()}
											{/if}
										</div>
										<div class="page_video_play_icon"></div>
										<span class="page_video_thumb" style="background-image: url('{$video->getThumbnailURL()}');"></span>
									</a>
									<div class="info clear">
										<a href="/video{$video->getPrettyId()}">{ovk_proc_strtr($video->getName(), 30)}</a>
									</div>
								</div>
							</div>
						</div>
						<div class="module audio_module" n:if="$audiosCount > 0 && $user->getPrivacyPermission('audios.read', $thisUser ?? NULL)">
							<a href="/audios{$user->getId()}" class="module_header">
								<h3 class="header_top clear_fix">
									<span class="header_label fl_l">
										{_audios}
									</span>
									<span class="header_count fl_l">
										{$audiosCount}
									</span>
								</h3>
							</a>
							<div class="module_body clear_fix">
								<div class="content_list long">
									<div class="audio_row" n:foreach="$audios as $audio">
										<a class="audio fl_l" href="/audios{$user->getId()}">
											<div class="page_audio_play_icon"></div>
										</a>
										<div class="info clear">
											{include "../Audio/player.latte", audio => $audio, hideButtons => true}
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<script n:if="$audiosCount > 0 && $user->getPrivacyPermission('audios.read', $thisUser ?? NULL)">
					window.__current_page_audio_context = {
						name: 'entity_audios',
						entity_id: {$user->getId()},
						page: 1
					};
				</script>
            </div>
        </div>
        <div class="wide_column_wrap">
            <div class="wide_column">
				<div class="page_block info_block nomobile">
					<div class="page_info_wrap">
						<div n:if="!is_null($alert = $user->getAlert())" class="user-alert">{strpos($alert, "@") === 0 ? tr(substr($alert, 1)) : $alert}</div>
						{var $thatIsThisUser = isset($thisUser) && $user->getId() == $thisUser->getId()}
						<div n:if="$thatIsThisUser" class="page_status_popup" id="status_editor" style="display: none;">
							<form name="status_popup_form" onsubmit="changeStatus(); return false;">
								<div style="margin-bottom: 10px;">
									<input type="text" name="status" size="50" value="{$user->getStatus()}" />
									<label class="checkbox">
										<input type="checkbox" name="broadcast" n:attr="checked => $user->isBroadcastEnabled()" />
										<span>{_broadcast_audio}</span>
									</label>
								</div>
								<input type="hidden" name="hash" value="{$csrfToken}" />
								<button type="submit" name="submit" class="button" style="height: 25px;">{_send}</button>
							</form>
						</div>
						<div class="accountInfo clearFix">
							<div class="page_top">
								<!-- DEBUG: ONLINE REPORT: static {$user->getOnline()->timestamp()}s adjusted {$user->getOnline()->timestamp() + 2505600}s real {time()}s -->
								<div class="profile_online" n:if="$user->getOnline()->timestamp() + 2505600 > time() || $user->onlineStatus() == 2">
									<div class="profile_online_status">
										{if $user->onlineStatus() == 2}
											{_deceased_person}
										{else}
											{if $user->isOnline()}
												{_online}
											{else}
												{$user->isFemale() ? tr("was_online_f") : tr("was_online_m")} {$user->getOnline()}
											{/if}
											{var $platform = $user->getOnlinePlatform()}
											{var $platformDetails = $user->getOnlinePlatformDetails()}
											<a n:if="!empty($platform)" class="client_app client_app_titlebar" data-app-tag="{$platform}" data-app-name="{$platformDetails['name']}" data-app-url="{$platformDetails['url']}" data-app-img="{$platformDetails['img']}">
												<img src="/assets/packages/static/openvk/img/app_icons_mini/{$user->getOnlinePlatform(true)}.svg">
											</a>
										{/if}
									</div>
								</div>
								<h2 class="page_name">{$user->getFullName()} <a class="page_verified" n:if="$user->isVerified()" href="/verify"></a></h2>

								{if !$audioStatus}
									{if $user->getStatus()}
										<div n:class="page_status, $thatIsThisUser ? page_status_edit_button" n:attr="id => $thatIsThisUser ? page_status_text : NULL">{$user->getStatus()}</div>
									{elseif $thatIsThisUser}
										<div n:class="page_status, edit_link, $thatIsThisUser ? page_status_edit_button" id="page_status_text">{_change_status}</div>
									{/if}
								{else}
									<div class="page_status" style="display: flex;">
										<div n:class="audioStatus, $thatIsThisUser ? page_status_edit_button" id="page_status_text">
											<a {if !$thatIsThisUser}href="/audio0_{$audioStatus->getId()}"{/if}>{$audioStatus->getName()}</a>
										</div>
									</div>
								{/if}
							</div>
						</div>
						{if $user->getPrivacyPermission('page.info.read', $thisUser ?? NULL)}
							<div class="basicInfo">
								<table id="basicInfo" class="ugc-table" border="0" cellspacing="0" cellpadding="0" border="0" cellspacing="0" cellpadding="0">
									<tbody>
										<tr>
											<td class="label"><span class="nobold">{_pronouns}: </span></td>
											<td class="data">{$user->isFemale() ? tr("female") : ($user->isNeutral() ? tr("neutral") : tr("male"))}</td>
										</tr>
										<tr>
											<td class="label"><span class="nobold">{_relationship}:</span></td>
											<td class="data">
												{$user->getLocalizedMaritalStatus()}
												{if $user->getMaritalStatusUser()}
													{$user->getMaritalStatusUserPrefix()}
													<a href="{$user->getMaritalStatusUser()->getURL()}" target="_blank">
														{$user->getMaritalStatusUser()->getCanonicalName()}
													</a>
												{/if}
											</td>
										</tr>
										<tr>
											<td class="label"><span class="nobold">{tr("registration_date")}: </span></td>
											<td class="data">{$user->getRegistrationTime()}</td>
										</tr>
										<tr n:if="!is_null($user->getHometown())">
											<td class="label"><span class="nobold">{tr("hometown")}:</span></td>
											<td class="data"><a href="/search?section=users&q=&hometown={urlencode($user->getHometown())}">{$user->getHometown()}</a></td>
										</tr>
										<tr>
											<td class="label"><span class="nobold">{tr("politViews")}:</span></td>
											<td class="data">{var $pviews = $user->getPoliticalViews()}{tr("politViews_$pviews")}</td>
										</tr>
										<tr n:if="!is_null($user->getBirthday())">
											<td class="label"><span class="nobold">{tr("birth_date")}:</span></td>
											<td n:if="$user->getBirthdayPrivacy() == 0" class="data">{$user->getBirthday()->format('%e %B %Y')},
												{tr("years", $user->getAge())}</td>
											<td n:if="$user->getBirthdayPrivacy() == 1" class="data">{$user->getBirthday()->format('%e %B')}</td>
										</tr>
									</tbody>
								</table>
							</div>
							<div class="profile_more_info">
								<a class="profile_info profile_more_info_link" onclick="switchProfileInfo();" id="showFullInfoButton">{_additional_information}</a>
								<div class="profileinfoblock profile_info_full" style="display:none;">
									{capture $contactInfo_Tmp}
										{var $contactFields = [
											['label' => email, 'value' => $user->getContactEmail(), 'type' => 'email'],
											['label' => telegram, 'value' => $user->getTelegram(), 'type' => 'telegram'],
											['label' => personal_website, 'value' => $user->getWebsite(), 'type' => 'website'],
											['label' => city, 'value' => $user->getCity(), 'type' => 'city'],
											['label' => address, 'value' => $user->getPhysicalAddress(), 'type' => 'address'],
										]}
										<table class="ugc-table" border="0" cellspacing="0" cellpadding="0" n:ifcontent>
										<tbody n:ifcontent>
											{foreach $contactFields as $field}
												<tr n:if="!is_null($field['value'])">
													<td class="label"><span class="nobold">{tr($field['label'])	}: </span></td>
													<td>
														{if $field['type'] === 'email'}
															<a href="mailto:{$field['value']}" rel="ugc">{$field['value']}</a>
														{elseif $field['type'] === 'telegram'}
															<a href="https://t.me/{$field['value']}" rel="ugc" target="_blank">@{$field['value']}</a>
														{elseif $field['type'] === 'website'}
															<a href="{$field['value']}" rel="ugc" target="_blank">{$field['value']}</a>
														{elseif $field['type'] === 'city'}
															<a href="/search?type=section&q=&city={$field['value']}">{$field['value']}</a>
														{else}
															{$field['value']}
														{/if}
													</td>
												</tr>
											{/foreach}
											{if $additionalFields}
												<tr n:foreach="$additionalFields['contacts'] as $field">
													<td class="label"><span class="nobold">{$field->getName()}:</span></td>
													<td class="data">{$field->getContent()}</td>
												</tr>
											{/if}
										</tbody>
										</table>
									{/capture}
									{capture $uInfo_Tmp}
										{var $personalFields = [
											['label' => interests, 'value' => $user->getInterests(), 'type' => 'list'],
											['label' => favorite_music, 'value' => $user->getFavoriteMusic(), 'type' => 'audio', 'url' => '/search?section=audios&q='],
											['label' => favorite_films, 'value' => $user->getFavoriteFilms(), 'type' => 'films', 'url' => '/search?section=users&q=&fav_films='],
											['label' => favorite_shows, 'value' => $user->getFavoriteShows(), 'type' => 'shows', 'url' => '/search?section=users&q=&fav_shows='],
											['label' => favorite_books, 'value' => $user->getFavoriteBooks(), 'type' => 'books', 'url' => '/search?section=users&q=&fav_books='],
											['label' => favorite_quotes, 'value' => $user->getFavoriteQuote(), 'type' => 'plain'],
											['label' => favorite_games, 'value' => $user->getFavoriteGames(), 'type' => 'plain'],
											['label' => information_about, 'value' => $user->getDescription(), 'type' => 'plain'],
										]}
										<table class="ugc-table" border="0" cellspacing="0" cellpadding="0" n:ifcontent>
											<tbody n:ifcontent>
												{foreach $personalFields as $field}
													<tr n:if="!is_null($field['value'])">
														<td class="label"><span class="nobold">{tr($field['label'])}: </span></td>
														<td class="data">
															{if $field['type'] === 'list'}
																{var $items = explode(', ', $field['value'])}
																{foreach $items as $item}
																	<span>{$item}</span>{if $item != end($items)},{/if}
																{/foreach}
															{elseif $field['type'] === 'audio' || $field['type'] === 'films' || $field['type'] === 'shows' || $field['type'] === 'books'}
																{var $items = explode(', ', $field['value'])}
																{foreach $items as $item}
																	<a href="{$field['url']}{urlencode($item)}">{$item}</a>{if $item != end($items)},{/if}
																{/foreach}
															{else}
																{$field['value']}
															{/if}
														</td>
													</tr>
												{/foreach}
												{if $additionalFields}
													<tr n:foreach="$additionalFields['interests'] as $field">
														<td class="label"><span class="nobold">{$field->getName()}:</span></td>
														<td class="data">{$field->getContent()}</td>
													</tr>
												{/if}
											</tbody>
										</table>
									{/capture}
									<div class="profile_info_block clear_fix">
										<div class="profile_info_header_wrap">
											<span class="profile_info_header">{_contact_information}</span>
										</div>
										{if !empty($contactInfo_Tmp)}
											{$contactInfo_Tmp|noescape}
										{else}
											<div class="no_info">{_no_information_provided}</div>
										{/if}
									</div>
									<div class="profile_info_block clear_fix">
										<div class="profile_info_header_wrap">
											<span class="profile_info_header">{_personal_information}</span>
										</div>
										{if !empty($uInfo_Tmp)}
											{$uInfo_Tmp|noescape}
										{else}
											<div class="no_info">{_no_information_provided}</div>
										{/if}
									</div>
								</div>
							</div>
						{else}
							<div class="no_info">
								<vkifyloc name="page_info_read_restricted"></vkifyloc>
							</div>
						{/if}
					</div>
					<div class="counts_module nomobile" n:ifcontent>
						<a class="page_counter" n:if="$user->getFollowersCount() > 0 && $user->getPrivacyPermission('friends.read', $thisUser ?? NULL)" href="/friends{$user->getId()}?act=incoming">
							<div class="count">{$user->getFollowersCount()}</div>
							<div class="label">{tr("followers")}</div>
						</a>
						<a class="page_counter" n:if="(new \openvk\Web\Models\Repositories\Photos())->getUserPhotosCount($user) > 0 && $user->getPrivacyPermission('photos.read', $thisUser ?? NULL)" href="/albums{$user->getId()}">
							<div class="count" id="profile_photos_counter_val">{(new \openvk\Web\Models\Repositories\Photos())->getUserPhotosCount($user)}</div>
							<div class="label">{tr("mobile_photos")}</div>
						</a>
						<a class="page_counter" n:if="\OPENVK_ROOT_CONF['openvk']['preferences']['commerce'] && ($giftCount = $user->getGiftCount()) > 0" href="/gifts{$user->getId()}">
							<div class="count">{$giftCount}</div>
							<div class="label">{tr("gifts")}</div>
						</a>
						<a class="page_counter" n:if="(new \openvk\Web\Models\Repositories\Videos())->getUserVideosCount($user) > 0 && $user->getPrivacyPermission('videos.read', $thisUser ?? NULL)" href="/videos{$user->getId()}">
							<div class="count">{(new \openvk\Web\Models\Repositories\Videos())->getUserVideosCount($user)}</div>
							<div class="label">{tr("videos")}</div>
						</a>
						<a class="page_counter" n:if="$audiosCount > 0 && $user->getPrivacyPermission('audios.read', $thisUser ?? NULL)" href="/audios{$user->getId()}">
							<div class="count">{$audiosCount}</div>
							<div class="label">{tr("audios")}</div>
						</a>
					</div>
				</div>
				{var $photoCount = (new \openvk\Web\Models\Repositories\Photos())->getUserPhotosCount($user)}
				<div class="page_block {if $photoCount > 0}module photos_module{/if}" id="page_photos_block" n:if="($photoCount > 0 && $user->getPrivacyPermission('photos.read', $thisUser ?? NULL)) || (isset($thisUser) && $user->getId() == $thisUser->getId())">
					<a class="module_header" href="/albums{$user->getId()}" {if $photoCount == 0}style="display: none"{/if} id="page_photos_module_header">
						<div class="header_top clear_fix">
							<span class="header_label fl_l">{_mobile_photos}</span>
							<span class="header_count fl_l" id="page_photos_module_count">{$photoCount}</span>
							<span class="a fl_r" n:if="isset($thisUser) && $user->getId() == $thisUser->getId()" onclick="event.stopPropagation(); event.preventDefault(); document.getElementById('page_photos_upload_input').click();">{_add_photos}</span>
						</div>
					</a>
					{if $photoCount > 0 }
						<div class="page_photos_module clear_fix" id="page_photos_grid">
							<a class="page_square_photo" n:foreach="($photos = iterator_to_array((new \openvk\Web\Models\Repositories\Photos())->getEveryUserPhoto($user, 0, 4))) as $photo" href="{$photo->getPageURL()}" onclick="OpenMiniature(event, {$photo->getURLBySizeId('large')}, null, {$photo->getPrettyId()}, null)" style="background-image: url({$photo->getURLBySizeId('normal')})"></a>
						</div>
					{else}
						{if isset($thisUser) && $user->getId() == $thisUser->getId()}
							<label for="page_photos_upload_input" class="page_module_upload" id="page_photos_upload_label">
								<div class="page_upload_label page_photos_upload"></div>{_add_photos}
							</label>
						{/if}
					{/if}
					{if isset($thisUser) && $user->getId() == $thisUser->getId()}
						<input type="file" id="page_photos_upload_input" accept="image/*" multiple style="display:none">
					{/if}
				</div>

				{presenter "openvk!Wall->wallEmbedded", $user->getId()}
			</div>
		</div>
	</div>

	{* "More information" MessageBox — pre-rendered hidden HTML element *}
	<div id="mobile_more_info_content" style="display:none;">
		{if $notesCount > 0 && $user->getPrivacyPermission('notes.read', $thisUser ?? NULL)}
		<a class="mobile-more-row" href="/notes{$user->getId()}"><span class="mir-icon mir-icon-notes"></span> {tr('notes', $notesCount)}</a>
		{/if}
		{if $albumsCount > 0 && $user->getPrivacyPermission('photos.read', $thisUser ?? NULL)}
		<a class="mobile-more-row" href="/albums{$user->getId()}"><span class="mir-icon mir-icon-album"></span> {tr('albums', $albumsCount)}</a>
		{/if}
		{if $user->getFollowersCount() > 0}
		<a class="mobile-more-row" href="/friends{$user->getId()}?act=incoming"><span class="mir-icon mir-icon-followers"></span> {tr('followers', $user->getFollowersCount())}</a>
		{/if}
		{var $photoCount2 = (new \openvk\Web\Models\Repositories\Photos())->getUserPhotosCount($user)}
		{if $photoCount2 > 0}
		<a class="mobile-more-row" href="/albums{$user->getId()}"><span class="mir-icon mir-icon-photos"></span> {_mobile_photos}: {$photoCount2}</a>
		{/if}
		{if \OPENVK_ROOT_CONF['openvk']['preferences']['commerce'] && $user->getGiftCount() > 0}
		<a class="mobile-more-row" href="/gifts{$user->getId()}"><span class="mir-icon mir-icon-gifts"></span> {tr('gifts', $user->getGiftCount())}</a>
		{/if}
		{if $videosCount > 0}
		<a class="mobile-more-row" href="/videos{$user->getId()}"><span class="mir-icon mir-icon-video"></span> {tr('videos', $videosCount)}</a>
		{/if}
		{if $audiosCount > 0}
		<a class="mobile-more-row" href="/audios{$user->getId()}"><span class="mir-icon mir-icon-audio"></span> {tr('audios_count', $audiosCount)}</a>
		{/if}
		{if $user->getPrivacyPermission('page.info.read', $thisUser ?? NULL)}
		{var $mEmail = $user->getContactEmail()}
		{var $mTelegram = $user->getTelegram()}
		{var $mWebsite = $user->getWebsite()}
		{if $mEmail || $mTelegram || $mWebsite}
		<hr class="mobile-more-sep">
		{if $mEmail}<a class="mobile-more-row" href="mailto:{$mEmail}"><span class="mir-icon mir-icon-email"></span> {$mEmail}</a>{/if}
		{if $mTelegram}<a class="mobile-more-row" href="https://t.me/{$mTelegram|replace:'@',''}"><span class="mir-icon mir-icon-telegram"></span> {$mTelegram}</a>{/if}
		{if $mWebsite}<a class="mobile-more-row" href="{$mWebsite}"><span class="mir-icon mir-icon-website"></span> {$mWebsite}</a>{/if}
		{/if}
		{var $infoFields = [
			['label' => tr('pronouns'), 'value' => ($user->isFemale() ? tr('female') : ($user->isNeutral() ? tr('neutral') : tr('male')))],
			['label' => tr('relationship'), 'value' => $user->getLocalizedMaritalStatus()],
			['label' => tr('registration_date'), 'value' => (string)$user->getRegistrationTime()],
			['label' => tr('hometown'), 'value' => $user->getHometown()],
			['label' => tr('politViews'), 'value' => tr('politViews_' . $user->getPoliticalViews())],
			['label' => tr('city'), 'value' => $user->getCity()],
			['label' => tr('interests'), 'value' => $user->getInterests()],
			['label' => tr('favorite_music'), 'value' => $user->getFavoriteMusic()],
			['label' => tr('favorite_films'), 'value' => $user->getFavoriteFilms()],

			['label' => tr('favorite_books'), 'value' => $user->getFavoriteBooks()],
			['label' => tr('favorite_quotes'), 'value' => $user->getFavoriteQuote()],
			['label' => tr('information_about'), 'value' => $user->getDescription()],
		]}
		{if array_filter(array_column($infoFields, 'value'), fn($v) => !is_null($v) && $v !== '')}
		<hr class="mobile-more-sep">
		<div class="form_group clear_fix">
		{foreach $infoFields as $mif}
			{if !is_null($mif['value']) && $mif['value'] !== ''}
			<div class="form_field"><div class="form_label">{$mif['label']}</div><div class="form_data" dir="auto">{$mif['value']}</div></div>
			{/if}
		{/foreach}
		</div>
		{/if}
		{/if}
	</div>

	{* Mobile appbar three-dots menu — server-rendered, used by JS tippy *}
	{ifset $thisUser}
	{if $user->getId() != $thisUser->getId() && !$user->isBanned() && !$user->isDeleted() && !$user->isDeactivated()}
	<div id="mobile_appbar_menu_content" class="tippy-menu">
		{if $thisUser->getChandlerUser()->can("access")->model("admin")->whichBelongsTo(NULL)}
			<a href="/admin/users/id{$user->getId()}">{_manage_user_action}</a>
			<div class="separator"></div>
		{/if}
		{var $isBlacklisted2 = $user->isBlacklistedBy($thisUser)}
		<a class="tippy-menu-item" id="_bl_toggler" data-name="{$user->getMorphedName('genitive', false)}" data-val="{if $isBlacklisted2}0{else}1{/if}" data-id="{$user->getRealId()}">
			{if $isBlacklisted2}{_bl_remove}{else}{_bl_add}{/if}
		</a>
		<a class="tippy-menu-item" href="javascript:reportUser({$user->getId()})">{_report}</a>
		{if !$user->isHideFromGlobalFeedEnabled()}
			{var $isIgnored2 = $user->isIgnoredBy($thisUser)}
			<a class="tippy-menu-item" id="__ignoreSomeone" data-val="{if $isIgnored2}0{else}1{/if}" data-id="{$user->getId()}">
				{if $isIgnored2}{_unignore_user}{else}{_ignore_user}{/if}
			</a>
		{/if}
	</div>
	{/if}
	{/ifset}

	<script>
	function __mobileProfileShowMore() {
		var el = document.getElementById('mobile_more_info_content');
		MessageBox(tr('additional_information'), el ? el.innerHTML : '', [tr('close')], [Function.noop]);
	}
	</script>

	<script n:if="isset($thisUser) && $user->getId() == $thisUser->getId()">
		(function() {
			var input = document.getElementById('page_photos_upload_input');
			if (!input) return;
			input.addEventListener('change', function() {
				var files = Array.from(this.files);
				if (!files.length) return;
				var userId = {$user->getId()};
				var csrf = document.querySelector('meta[name=csrf]')?.getAttribute('value') || '';
				files.forEach(function(file) {
					if (!file.type.startsWith('image/')) return;
					var fd = new FormData();
					fd.append('photo_0', file);
					fd.append('count', 1);
					fd.append('hash', csrf);
					fetch('/photos/upload?upload_context=' + userId, { method: 'POST', body: fd })
						.then(function(r) { return r.json(); })
						.then(function(data) {
							if (!data.success) return;
							data.photos.forEach(function(photo) {
								var block = document.getElementById('page_photos_block');
								var grid = document.getElementById('page_photos_grid');
								var label = document.getElementById('page_photos_upload_label');
								var header = document.getElementById('page_photos_module_header');
								var count = document.getElementById('page_photos_module_count');
								var profileCount = document.getElementById('profile_photos_counter_val');

								if (!grid) {
									block.classList.add('module', 'photos_module');
									var newGrid = document.createElement('div');
									newGrid.className = 'page_photos_module clear_fix';
									newGrid.id = 'page_photos_grid';
									if (label) label.parentNode.insertBefore(newGrid, label);
									else block.appendChild(newGrid);
									grid = newGrid;
								}

								if (header) header.style.display = '';
								if (count) count.textContent = parseInt(count.textContent || 0) + 1;
								if (profileCount) profileCount.textContent = parseInt(profileCount.textContent || 0) + 1;
								if (label) label.style.display = 'none';

								var a = document.createElement('a');
								a.className = 'page_square_photo';
								a.href = '/photo' + photo.pretty_id;
								a.setAttribute('onclick', 'OpenMiniature(event, \'' + photo.link + '\', null, \'' + photo.pretty_id + '\', null)');
								a.style.backgroundImage = 'url(' + photo.url + ')';
								grid.insertBefore(a, grid.firstChild);
								while (grid.children.length > 4) grid.removeChild(grid.lastChild);
							});
						})
						.catch(function(e) { console.error('Photo upload error', e); });
				});
				input.value = '';
			});
		})();
	</script>

	<script n:if="isset($thisUser) && $thisUser->getChandlerUser()->can('access')->model('admin')->whichBelongsTo(NULL)">
		function banUser() {
			uBanMsgTxt  = "Вы собираетесь забанить пользователя " + {$user->getCanonicalName()} + ".";
			uBanMsgTxt += "<br/><b>Предупреждение</b>: Это действие удалит все подписки пользователя и отпишет всех от него.";
			uBanMsgTxt += "<br/><br/><b>Причина бана</b>: <input type='text' id='uBanMsgInput' placeholder='придумайте что-нибудь крутое' />"
			uBanMsgTxt += "<br/><br/><b>Заблокировать до</b>: <input type='date' id='uBanMsgDate' />";
			uBanMsgTxt += "<br/><br/><label class='checkbox'><input id='uBanMsgIncr' type='checkbox' checked='1'/><span>Автоматически <b>(до " + {date('d.m.Y H\h', time() + $user->getNewBanTime())} + ")</b></span></label>";

			MessageBox("Забанить " + {$user->getFirstName()}, uBanMsgTxt, ["Подтвердить", "Отмена"], [
				(function() {
					res = document.querySelector("#uBanMsgInput").value;
					date = document.querySelector("#uBanMsgDate").value;
					incr = document.querySelector("#uBanMsgIncr").checked ? '1' : '0';
					xhr = new XMLHttpRequest();
					xhr.open("GET", "/admin/ban/" + {$user->getId()} + "?reason=" + res + "&incr=" + incr + "&date=" + date + "&hash=" + {rawurlencode($csrfToken)}, true);
					xhr.onload = (function() {
						if(xhr.responseText.indexOf("success") === -1)
							MessageBox("Ошибка", "Не удалось забанить пользователя...", ["OK"], [Function.noop]);
						else
							MessageBox("Операция успешна", "Пользователь заблокирован", ["OK"], [Function.noop]);
					});
					xhr.send(null);
				}),
				Function.noop
			]);
		}
		
		function warnUser() {
			uBanMsgTxt  = "Вы собираетесь предупредить пользователя " + {$user->getCanonicalName()} + ".";
			uBanMsgTxt += "<br/>Мы отправим уведомление пользователю в личные сообщения от имени аккаунта администратора.";
			uBanMsgTxt += "<br/><br/><b>Текст предупреждения</b>: <input type='text' id='uWarnMsgInput' placeholder='придумайте что-нибудь крутое' />";
			
			MessageBox("Выдать предупреждение " + {$user->getFirstName()}, uBanMsgTxt, ["Подтвердить", "Отмена"], [
				(function() {
					res = document.querySelector("#uWarnMsgInput").value;
					xhr = new XMLHttpRequest();
					xhr.open("GET", "/admin/warn/" + {$user->getId()} + "?message=" + res + "&hash=" + {rawurlencode($csrfToken)}, true);
					xhr.onload = (function() {
						if(xhr.responseText.indexOf("message") === -1)
							MessageBox("Ошибка", "Не удалось отправить предупреждение...", ["OK"], [Function.noop]);
						else
							MessageBox("Операция успешна", "Предупреждение отправлено", ["OK"], [Function.noop]);
					});
					xhr.send(null);
				}),
				Function.noop
			]);
		}
	</script>

	<script n:if="isset($thisUser) && $thisUser->getChandlerUser()->can('write')->model('openvk\Web\Models\Entities\TicketReply')->whichBelongsTo(0)">
		{if $user->isBannedInSupport()}
			function toggleBanInSupport() {
				uBanMsgTxt  = "Вы собираетесь разблокировать в поддержке пользователя " + {$user->getCanonicalName()} + ".";
				uBanMsgTxt += "<br/>Сейчас он заблокирован по причине <strong>" + {$user->getBanInSupportReason()} + "</strong>.";

				MessageBox("Разблокировать в поддержке " + {$user->getFirstName()}, uBanMsgTxt, ["Подтвердить", "Отмена"], [
					(function() {
						xhr = new XMLHttpRequest();
						xhr.open("GET", "/admin/support/unban/" + {$user->getId()} + "?hash=" + {rawurlencode($csrfToken)}, true);
						xhr.onload = (function() {
							if(xhr.responseText.indexOf("success") === -1)
								MessageBox("Ошибка", "Не удалось разблокировать пользователя в поддержке...", ["OK"], [Function.noop]);
							else
								MessageBox("Операция успешна", "Пользователь разблокирован в поддержке", ["OK"], [Function.noop]);
						});
						xhr.send(null);
					}),
					Function.noop
				]);
			}
		{else}
			function toggleBanInSupport() {
				uBanMsgTxt  = "Вы собираетесь заблокировать в поддержке пользователя " + {$user->getCanonicalName()} + ".";
				uBanMsgTxt += "<br/><br/><b>Причина бана</b>: <input type='text' id='uBanMsgInput' placeholder='придумайте что-нибудь крутое' />";
				uBanMsgTxt += "<br/><br/><label class='checkbox'><input type='checkbox' id='uBanClsTicketsInput' /><span>Закрыть все обращения пользователя</span></label>";

				MessageBox("Заблокировать в поддержке " + {$user->getFirstName()}, uBanMsgTxt, ["Подтвердить", "Отмена"], [
					(function() {
						res = document.querySelector("#uBanMsgInput").value;
						cls = document.querySelector("#uBanClsTicketsInput").value;
						xhr = new XMLHttpRequest();
						xhr.open("GET", "/admin/support/ban/" + {$user->getId()} + "?reason=" + res + "&close_tickets=" + cls + "&hash=" + {rawurlencode($csrfToken)}, true);
						xhr.onload = (function() {
							if(xhr.responseText.indexOf("success") === -1)
								MessageBox("Ошибка", "Не удалось заблокировать пользователя в поддержке...", ["OK"], [Function.noop]);
							else
								MessageBox("Операция успешна", "Пользователь заблокирован в поддержке", ["OK"], [Function.noop]);
						});
						xhr.send(null);
					}),
					Function.noop
				]);
			}
		{/if}
	</script>
    {/if}

    <script>
    (function() {
        var isMobile = window.matchMedia('(max-width: 768px)').matches;
        if (!isMobile) return;

        var appbar = document.getElementById('appbar');
        var hero = document.querySelector('.mobile-profile-hero');

        if (appbar) {
            document.body.classList.add('has-transparent-appbar');
            var heroHeight = hero ? hero.offsetHeight : 200;
            window.__profileAppbarScrollHandler = function() {
                var scrollY = window.scrollY || window.pageYOffset;
                var progress = Math.min(scrollY / Math.max(heroHeight - 56, 1), 1);
                appbar.style.setProperty('--appbar-bg-alpha', progress);
                if (progress <= 0) {
                    appbar.classList.add('appbar--transparent');
                    appbar.classList.remove('appbar--scrolled');
                } else if (progress >= 1) {
                    appbar.classList.remove('appbar--transparent');
                    appbar.classList.add('appbar--scrolled');
                } else {
                    appbar.classList.remove('appbar--transparent', 'appbar--scrolled');
                }
            };
            window.__profileAppbarScrollHandler();
            window.addEventListener('scroll', window.__profileAppbarScrollHandler, {'passive': true});
        }

        var moreBtn = document.getElementById('profileAppbarMoreBtn');
        if (moreBtn && window.Tooltips) {
            TIPPY_PRESETS['appbar_menu'] = {
                trigger: 'click',
                theme: 'light vk',
                placement: 'bottom-end',
                appendTo: document.body,
            };
            Tooltips.initializeTooltip(moreBtn);
        }
    })();
    </script>
    
    {else} {* isBanned() *}
        {include "banned.latte"}
    {/if}
{/block}
