{extends "../@layout.latte"}
{block title}{_wall}{/block}

{block content}
{var $menuItems = [
    [
        'url' => '/wall' . $owner . '?type=owners',
        'title' => isset($club) ? "clubs_posts" : tr("users_posts", ovk_proc_strtr($oObj->getFirstName(), 20)),
        'translate' => isset($club) ? true : false,
        'active' => $type == 'owners'
    ],
    [
        'url' => '/wall' . $owner,
        'title' => 'all_posts',
        'active' => $type == 'all'
    ],
    [
        'url' => "/notes" . $owner,
        'title' => 'notes',
        'active' => false,
        'condition' => $owner > 0
    ],
    [
        'url' => '/wall' . $owner . '?type=archive',
        'title' => 'archived_posts',
        'active' => $type == 'archive',
        'condition' => isset($thisUser) && (
            ($owner > 0 && $thisUser->getId() === $oObj->getId()) ||
            ($owner < 0 && isset($club) && $club->canBeModifiedBy($thisUser))
        )
    ]
]}

    <div class="wide_column_left">
        <div class="narrow_column_wrap">
            <div class="narrow_column">
                {include "../components/ui_rmenu.latte", items => $menuItems, ownblockData => $oObj}
            </div>
        </div>
        <div class="wide_column_wrap">
            <div class="wide_column">
                <div n:if="$canPost && $type != 'archive'" class="page_block postFeedWrapperMicroblog">
                    {include "../components/textArea.latte", route => "/wall$owner/makePost", graffiti => true, polls => true, notes => true, hasSource => true, geo => true}
                </div>
                <div n:if="$type != 'archive'" class="page_block wall_posts_tabs">
                    {include "../components/page_block_header.latte", title => $type == 'search' ? 'search_results' : 'wall', extra => '<a href="/wall'.$owner.'/rss" class="button">'.tr('read_in_rss').'</a>'}
                </div>
                {capture $wallPostsContent}
                    <div id="{$type == 'owners' ? 'owner_posts' : ($type == 'archive' ? 'archive_wall_posts' : 'all_posts')}" class="content scroll_container">
                        <div class="page_block" style="margin: 0">
                            {include "../components/search_bar.latte",
                                id => 'wall_search',
                                form_id => 'wall_search_form',
                                action => "/wall{$owner}",
                                input_name => 'q',
                                input_value => $_GET['q'] ?? '',
                                hidden_fields => ['type' => 'search'],
                                class => '_wrap ui_search_old'}
                        </div>
                        {if sizeof($posts) > 0}
                            {foreach $posts as $post}
                                {include "../components/post.latte", post => $post, commentSection => true}
                            {/foreach}
                            {include "../components/paginator.latte", conf => $paginatorConf}
                        {elseif $type != 'search'}
                            <div class="page_block">
                                {include "../components/content_error.latte", description => tr("no_posts_abstract")}
                            </div>
                        {else}
                            <div class="page_block">
                                {include "../components/content_error.latte", description => tr("no_found")}
                            </div>
                        {/if}
                    </div>
                {/capture}

                {if $type == 'archive'}
                    <div id="archive_posts_container">
                    <div class="page_block archive_banner">
                        <div class="archive_banner_text">
                            <b class="archive_banner_title">{_archive_banner_title}</b>
                            <span class="archive_banner_description">{_archive_banner_desc}</span>
                        </div>
                    </div>

                    {var $currentArchiveYear = $archiveYear ?? ($archiveYears[0] ?? NULL)}
                    {if sizeof($archiveYears) > 0}
                        {var $postsRepo = new \openvk\Web\Models\Repositories\Posts()}
                        {var $archiveAllCount = ($type == 'archive' && is_null($archiveYear)) ? $count : $postsRepo->getArchivedCountOnUserWall($owner)}
                        {var $archiveCounts = array_combine($archiveYears, array_map(fn($year) => ($type == 'archive' && !is_null($archiveYear) && $year === $archiveYear) ? $count : $postsRepo->getArchivedCountOnUserWall($owner, $year), $archiveYears))}

                        {var $archiveTabs = array_merge(
                            [[
                                'url' => "/wall{$owner}?type=archive",
                                'title' => 'archive_all_years',
                                'active' => is_null($archiveYear),
                                'count' => $archiveAllCount
                            ]],
                            array_map(fn($year) => [
                                'url' => "/wall{$owner}?type=archive&year={$year}",
                                'title' => (string) $year,
                                'translate' => false,
                                'active' => !is_null($archiveYear) && $year === $archiveYear,
                                'count' => $archiveCounts[$year] ?? 0
                            ], $archiveYears)
                        )}

                        {capture $archiveActionsExtra}
                            <div class="fl_r archive_actions_button sort_link" data-tippy-content-id="archive_actions_menu" data-tippy-placement="bottom-end" data-tippy-append-to="body">{_actions} <div class="sort_link_icon sort_link_icon_asc"></div></div>
                            <div id="archive_actions_menu" class="tippy-menu tippy-content-template">
                                <form method="post" action="/wall{$owner}/archive/manage">
                                    <input type="hidden" name="hash" value="{$csrfToken}">
                                    <input type="hidden" name="action" value="archive_year">
                                    <input type="hidden" name="year" value="{$currentArchiveYear}">
                                    <button type="submit" data-confirm="{tr('archive_confirm_year', $currentArchiveYear)}" onclick="return confirm(this.dataset.confirm)">{tr('archive_all_posts_from_year', $currentArchiveYear)}</button>
                                </form>
                                <form method="post" action="/wall{$owner}/archive/manage">
                                    <input type="hidden" name="hash" value="{$csrfToken}">
                                    <input type="hidden" name="action" value="restore_year">
                                    <input type="hidden" name="year" value="{$currentArchiveYear}">
                                    <button type="submit" data-confirm="{tr('restore_confirm_year', $currentArchiveYear)}" onclick="return confirm(this.dataset.confirm)">{tr('restore_all_posts_from_year', $currentArchiveYear)}</button>
                                </form>
                                <div class="separator"></div>
                                <form method="post" action="/wall{$owner}/archive/manage">
                                    <input type="hidden" name="hash" value="{$csrfToken}">
                                    <input type="hidden" name="action" value="archive_all">
                                    <button type="submit" data-confirm="{_archive_confirm_all}" onclick="return confirm(this.dataset.confirm)">{_archive_all_posts}</button>
                                </form>
                            </div>
                        {/capture}

                        <div class="page_block wall_posts_tabs">
                            {include "../components/page_tabs_header.latte", tabs => $archiveTabs, id => 'archive_top_tabs', white => true, extra => $archiveActionsExtra}
                        </div>
                    {/if}
                    {$wallPostsContent|noescape}
                </div>
                {else}
                    {$wallPostsContent|noescape}
                {/if}
            </div>
        </div>
    </div>
{/block}

{block bodyScripts}
    <script src="/themepack/vkify16/{$theme->getVersion()}/resource/js/features/suggestions.js"></script>
    <script n:if='$type == "search" && sizeof($posts) > 0 && !empty($_GET["q"])'>
        function __scrollHook(page) {
            highlightText({$_GET["q"]}, '.content', ['.wall_post_text'])
        }
        __scrollHook()
    </script>
{/block}